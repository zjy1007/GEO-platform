# Copy to .env and fill in. NEVER commit the real .env.

# --- app ---
APP_NAME=GEO Platform
ENV=dev
DEBUG=true

# --- postgres (async DSN) ---
DATABASE_URL=postgresql+asyncpg://geo:geo@postgres:5432/geo

# --- redis ---
REDIS_URL=redis://redis:6379/0

# --- minio ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=geo-assets
MINIO_SECURE=false

# --- auth (P0 single shared token; leave empty to disable auth locally) ---
API_TOKEN=
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000000

# --- observability ---
SENTRY_DSN=

# --- frontend ---
NEXT_PUBLIC_API_BASE=http://localhost:8000/api

# --- provider API keys (referenced by providers.yaml; verify model ids per vendor docs) ---
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
MOONSHOT_API_KEY=
